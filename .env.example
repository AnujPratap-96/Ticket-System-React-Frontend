VITE_API_URL=http://127.0.0.1:8000/api/v1

# Demo role-switcher in the header (dev server only). Leave off for anything shared.
# VITE_ENABLE_DEMO_SWITCHER=true

# Realtime (optional). Same key as the API's REVERB_APP_KEY; host/port/scheme are where the BROWSER reaches Reverb.
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http

# Multi-tenancy (frontend). Wildcard domain for workspaces, and the workspace to use by default in local development.
# VITE_TENANT_BASE_DOMAIN=
# VITE_DEFAULT_TENANT=techcorp
# Cloudflare Turnstile site key (public). Shows the human check on sign-up / forgot password; the API needs TURNSTILE_SECRET too.
# VITE_TURNSTILE_SITE_KEY=
# Demo switcher password (dev only; same as the API DEMO_PASSWORD)
# VITE_DEMO_PASSWORD=
